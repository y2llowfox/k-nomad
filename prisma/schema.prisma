datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── User Model ──────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  nickname      String?   @unique
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  tier          String    @default("free")
  profession    String?
  reviews       Review[]
  reviewVotes   ReviewVote[]
  cityVotes     CityVote[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ─── Domain Models ───────────────────────────────────

model City {
  slug         String  @id
  name         String
  nameEn       String
  region       String
  category     String
  description  String
  imageUrl     String
  overallScore Float
  reviewCount  Int     @default(0)
  monthlyCost  Float
  internetSpeed Float
  currentTemp  Float
  weatherIcon  String
  hasKTX       Boolean
  isSeaside    Boolean
  likes        Int     @default(0)
  dislikes     Int     @default(0)
  environment  Json    @default("[]")
  bestSeason   Json    @default("[]")

  metrics    CityMetric[]
  costs      CostItem[]
  highlights CityHighlight[]
  tags       ProConTag[]
  weather    MonthlyWeather[]
  photos     CityPhoto[]
  nearbyFrom CityNearby[] @relation("NearbyFrom")
  nearbyTo   CityNearby[] @relation("NearbyTo")
  reviews    Review[]
  coworkings CoworkingSpace[]
  programs   WorkationProgram[]
  meetups    Meetup[]
  votes      CityVote[]

  @@index([likes])
  @@index([region])
  @@index([monthlyCost])
}

model CityVote {
  id       Int    @id @default(autoincrement())
  userId   String
  citySlug String
  type     String // "like" | "dislike"
  city     City   @relation(fields: [citySlug], references: [slug], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, citySlug])
}

model CityMetric {
  id       Int     @id @default(autoincrement())
  citySlug String
  key      String
  label    String
  emoji    String
  score    Float
  detail   String?
  city     City    @relation(fields: [citySlug], references: [slug], onDelete: Cascade)

  @@unique([citySlug, key])
}

model CostItem {
  id       Int    @id @default(autoincrement())
  citySlug String
  category String
  amount   Float
  unit     String
  city     City   @relation(fields: [citySlug], references: [slug], onDelete: Cascade)
}

model CityHighlight {
  id       Int    @id @default(autoincrement())
  citySlug String
  text     String
  city     City   @relation(fields: [citySlug], references: [slug], onDelete: Cascade)
}

model ProConTag {
  id       String @id @default(cuid())
  citySlug String
  text     String
  emoji    String
  type     String
  votes    Int    @default(0)
  city     City   @relation(fields: [citySlug], references: [slug], onDelete: Cascade)
}

model MonthlyWeather {
  id       Int    @id @default(autoincrement())
  citySlug String
  month    Int
  avgTemp  Float
  rainfall Float
  humidity Float
  city     City   @relation(fields: [citySlug], references: [slug], onDelete: Cascade)

  @@unique([citySlug, month])
}

model CityPhoto {
  id       Int    @id @default(autoincrement())
  citySlug String
  url      String
  city     City   @relation(fields: [citySlug], references: [slug], onDelete: Cascade)
}

model CityNearby {
  id       Int    @id @default(autoincrement())
  fromSlug String
  toSlug   String
  fromCity City   @relation("NearbyFrom", fields: [fromSlug], references: [slug], onDelete: Cascade)
  toCity   City   @relation("NearbyTo", fields: [toSlug], references: [slug], onDelete: Cascade)

  @@unique([fromSlug, toSlug])
}

model CoworkingSpace {
  id           String  @id
  citySlug     String
  name         String
  address      String
  dailyPrice   Int
  monthlyPrice Int?
  amenities    Json    @default("[]")
  hours        String
  rating       Float
  imageUrl     String
  city         City    @relation(fields: [citySlug], references: [slug], onDelete: Cascade)
}

model Review {
  id             String       @id @default(cuid())
  citySlug       String
  authorId       String?
  authorNickname String
  visitPeriod    String
  duration       String
  profession     String
  overallScore   Float
  text           String
  recommendation String
  helpful        Int          @default(0)
  unhelpful      Int          @default(0)
  createdAt      DateTime     @default(now())
  city           City         @relation(fields: [citySlug], references: [slug], onDelete: Cascade)
  author         User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  votes          ReviewVote[]
}

model ReviewVote {
  id       Int    @id @default(autoincrement())
  reviewId String
  userId   String
  type     String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
}

model WorkationProgram {
  id          String @id
  citySlug    String
  title       String
  period      String
  subsidy     String
  description String
  city        City   @relation(fields: [citySlug], references: [slug], onDelete: Cascade)
}

model Meetup {
  id        String @id
  citySlug  String
  date      String
  title     String
  attendees Int
  city      City   @relation(fields: [citySlug], references: [slug], onDelete: Cascade)
}
